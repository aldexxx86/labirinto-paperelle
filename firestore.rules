rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // classifica/{difficolta}/punteggi/{id}: chiunque legge, si possono solo aggiungere punteggi validi
    match /classifica/{diff}/punteggi/{id} {
      allow read: if diff in ['facile', 'normale', 'difficile'];
      allow create: if diff in ['facile', 'normale', 'difficile']
        && request.resource.data.keys().hasOnly(['name', 'score', 'ducks', 'rainbow', 'time', 'date'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 16
        && request.resource.data.score is int && request.resource.data.score >= 0 && request.resource.data.score <= 1200
        && request.resource.data.ducks is int && request.resource.data.ducks >= 1 && request.resource.data.ducks <= 1000
        && request.resource.data.rainbow is int && request.resource.data.rainbow >= 0 && request.resource.data.rainbow <= 50
        && request.resource.data.time is int && request.resource.data.time >= 0
        && request.resource.data.date == request.time;
      allow update, delete: if false;
    }
  }
}
